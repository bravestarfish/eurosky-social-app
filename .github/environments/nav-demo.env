# https://nav-demo.mu.social - preview of the no-video navigation redesign
# (branch mu/nav-redesign-no-video). Feature settings match production so the
# demo shows the redesign as mu.social users would get it.
#
# Not a GitHub environment: built locally with
#   ./scripts/web_build.sh nav-demo
# and uploaded to its own Bunny storage zone with scripts/bunny_upload.sh.

DEPLOY_URL=https://nav-demo.mu.social

# Disallow-all robots.txt so the demo stays out of search.
ROBOTS_MODE=disallow-all

# Own OAuth client; assertions from the shared non-prod worker, which accepts
# any *.mu.social origin (see staging.env).
EXPO_PUBLIC_OAUTH_BASE_URL=https://nav-demo.mu.social
EXPO_PUBLIC_OAUTH_ASSERTION_URL=https://oauth-staging.mu.social/client-assertion

# Unregistered in Plausible, so demo traffic never pollutes prod stats.
EXPO_PUBLIC_PLAUSIBLE_DOMAIN=nav-demo.mu.social

# As production.
EXPO_PUBLIC_ENABLE_SPORTS=false
EXPO_PUBLIC_FOOTBALLDATA_API_URL=https://sports.mu.social/v4
EXPO_PUBLIC_APPVIEW_SHADOW_PERCENTAGE=50

# The edge rules in scripts/bunny_edge_setup.sh target mu.social's own zones.
DEPLOY_BUNNY_EDGE_SETUP=false
